# Voice Chat client environment variables
# Back-end base URLs (include protocol). For HTTPS pages, WebSocket will auto-upgrade to wss://.
REACT_APP_BACKEND_HTTP_URL=http://localhost:8000
REACT_APP_BACKEND_WS_URL=ws://localhost:8000

# Session and language defaults
REACT_APP_SESSION_ID=web-client
REACT_APP_LANGUAGE=id

# Preferred audio MIME for MediaRecorder. Browser may override if unsupported.
REACT_APP_AUDIO_MIME=audio/wav
